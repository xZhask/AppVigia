# Única carpeta pública del sistema: anula el "Require all denied" del
# .htaccess de la raíz del proyecto (ver ese archivo).
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Compresión gzip (red lenta en las IPRESS: el panel baja de 363 KB a 18 KB).
# Solo tipos de texto: el .xlsx ya es un zip. Requiere mod_deflate y mod_filter;
# sin ellos este bloque no hace nada (el Apache de Laragon los trae desactivados).
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]
